<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCredencialesPrueba"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="Test Login:\nUser: admin\nPass: 1234"
        android:textSize="12sp"
        android:textColor="#888888"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/menuNavegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvCredencialesPrueba"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnActividad1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ej 1" />
        <Button
            android:id="@+id/btnActividad2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ej 2" />
        <Button
            android:id="@+id/btnActividad3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ej 3" />
    </LinearLayout>

    <!-- CONTENEDOR ACTIVIDAD 1 -->
    <LinearLayout
        android:id="@+id/contenedorEj1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/menuNavegacion"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvTextoEj1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Texto original"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>
        <Button
            android:id="@+id/btnCambiarTextoEj1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cambiar texto" />
    </LinearLayout>

    <!-- CONTENEDOR ACTIVIDAD 2 -->
    <LinearLayout
        android:id="@+id/contenedorEj2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/menuNavegacion"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <EditText
            android:id="@+id/etNumero1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese primer número"
            android:inputType="numberDecimal" />
        <EditText
            android:id="@+id/etNumero2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese segundo número"
            android:inputType="numberDecimal" />
        <Button
            android:id="@+id/btnSumarEj2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sumar" />
        <TextView
            android:id="@+id/tvResultadoEj2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="24sp"
            android:text="Resultado: " />
    </LinearLayout>

    <!-- CONTENEDOR ACTIVIDAD 3 -->
    <LinearLayout
        android:id="@+id/contenedorEj3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/menuNavegacion"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEstadoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intentos restantes: 3"
            android:layout_marginBottom="16dp"/>
        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de usuario" />
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword" />
        <Button
            android:id="@+id/btnValidarEj3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Validar" />
    </LinearLayout>

</RelativeLayout>